; snake-03.mic - Snake für Busch Microtronic 2090 mit 8x8-LED-Matrix (ESP2090 Studio) und 4 Tastern
; 253 Schritte (00-FC), frei: 3
; Version 03: Matrix des ESP2090 Studios. Zwischen den Bildern schlaeft sie (ACK 15, kein REQ), damit Eingang 1
;   Taster links sein kann; vor dem Bild weckt F, dann folgt sofort ACK 1 mit den 16 Registern.
; Start: Reset, Matrix einschalten (Weboberflaeche: LED on, Emulator2090: m), RUN.
;   Matrix vergessen? Das Programm wartet am Anfang ohne Bild: Matrix einschalten.
; Taster 1-4 = links, hoch, runter, rechts (Pfeiltasten). Umkehr wird ignoriert,
;   mehrere Taster: der niedrigste zählt. Taste halten, bis die Schlange reagiert.
; Die Matrix ist nur für das Bild wach, sonst schlaeft sie: Eingang 1 ist dann Taster links.
; Start mit Länge 2. Spielende (Rand oder sich selbst): Anzeige der Länge dezimal. Länge 12 = gewonnen.
; Ein Zug dauert etwa 1,4 s (155 Befehle), mit gehaltener Taste 1,8 s.
;
; #define (Register)
;   KOPF_I  r0  Kopf: Matrixregister 0-F (2 * Zeile + Hälfte)
;   KOPF_M  r1  Kopf: Bitmaske 1, 2, 4, 8 (Bit 1 = linke LED)
;   SCHW_I  r2  Schwanz: Matrixregister
;   SCHW_M  r3  Schwanz: Bitmaske
;   FUTT_I  r4  Futter: Matrixregister
;   FUTT_M  r5  Futter: Bitmaske
;   LAENGE  r6  Länge der Schlange 2-11 (= Platz der Schwanzrichtung)
;   Q0      r7  Richtungsschlange: Platz j in Q(j mod 6), Bit 1-2 für j<6, Bit 3-4 für j>=6
;   Q1      r8  Platz 0 = Vorwahl (Taste), Platz 1 = letzter Zug
;   Q2      r9
;   Q3      rA
;   Q4      rB
;   Q5      rC
;   IDX     rD  Hilfsregister: Matrixregister für Zelle/Schritt
;   T       rE  Hilfsregister: Ergebnis von Zelle, Richtung für Schritt
;   MASKE   rF  Hilfsregister: Bitmaske für Zelle/Schritt
;   RICHT   rE  Richtung für Schritt (= T): 0 links, 1 hoch, 2 runter, 3 rechts
;

F02   ; 00  Beginn   DISOUT                   Anzeige aus: 9,3 ms je Befehl (Takt der Matrix)
1C6   ; 01           MOVI    #C,LAENGE        Startbild: Zeile 4, Spalte 3-4 ...
F76   ; 02           MAS     LAENGE           ... nach M6 (Matrix liegt in M0-MF)
126   ; 03           MOVI    #2,LAENGE        Länge 2
160   ; 04           MOVI    #6,KOPF_I        Kopf Zeile 4, Spalte 4
181   ; 05           MOVI    #8,KOPF_M
162   ; 06           MOVI    #6,SCHW_I        Schwanz Zeile 4, Spalte 3
143   ; 07           MOVI    #4,SCHW_M
137   ; 08           MOVI    #3,Q0            Richtung 3 = rechts: Vorwahl ...
138   ; 09           MOVI    #3,Q1            ... und der letzte Zug
BF5   ; 0A           CALL    Schlaf           Matrix schlafen: Eingang 1 frei fuer Taster links

F05   ; 0B  Futter   RND                      neues Futter: IDX = Register, T = Spalte im Register
11F   ; 0C           MOVI    #1,MASKE
33E   ; 0D           ANDI    #3,T

71E   ; 0E  FL       SUBI    #1,T             Maske = 1 << T
D12   ; 0F           BRC     FD
4FF   ; 10           ADD     MASKE,MASKE
C0E   ; 11           GOTO    FL

0D4   ; 12  FD       MOV     IDX,FUTT_I
0F5   ; 13           MOV     MASKE,FUTT_M
BB0   ; 14           CALL    Zelle            Futter setzen
E18   ; 15           BRZ     Frame            Zelle war frei
BB0   ; 16           CALL    Zelle            war Schlange: zurückschalten, neu würfeln
C0B   ; 17           GOTO    Futter

BF8   ; 18  Frame    CALL    Tog              Matrix wecken (F, dann 0): der ESP setzt sofort REQ
F0D   ; 19           EXRL                     R0-R7 = Matrix Zeile 1-4, Variablen nach M0-M7

11F   ; 1A           MOVI    #1,MASKE         ACK 1 = Blockmodus (REQ steht nach dem Wecken)
FEF   ; 1B           DOT     MASKE            ACK 1
F0E   ; 1C           EXRM                     genau ein Befehl zwischen ACK und erstem Wert: R8-RF = Zeile 5-8
FE0   ; 1D           DOT     r0               Zeile 1 links
FE1   ; 1E           DOT     r1               Zeile 1 rechts
FE2   ; 1F           DOT     r2               Zeile 2 links
FE3   ; 20           DOT     r3               Zeile 2 rechts
FE4   ; 21           DOT     r4               Zeile 3 links
FE5   ; 22           DOT     r5               Zeile 3 rechts
FE6   ; 23           DOT     r6               Zeile 4 links
FE7   ; 24           DOT     r7               Zeile 4 rechts
FE8   ; 25           DOT     r8               Zeile 5 links
FE9   ; 26           DOT     r9               Zeile 5 rechts
FEA   ; 27           DOT     rA               Zeile 6 links
FEB   ; 28           DOT     rB               Zeile 6 rechts
FEC   ; 29           DOT     rC               Zeile 7 links
FED   ; 2A           DOT     rD               Zeile 7 rechts
FEE   ; 2B           DOT     rE               Zeile 8 links
FEF   ; 2C           DOT     rF               Zeile 8 rechts
F0E   ; 2D           EXRM                     Variablen zurück
10F   ; 2E           MOVI    #0,MASKE
FEF   ; 2F           DOT     MASKE            Ausgaenge 0: Uebertragung fertig
F0D   ; 30           EXRL
BF5   ; 31           CALL    Schlaf           Matrix schlafen: Eingang 1 ist wieder Taster links

B7F   ; 32  Tick     CALL    Taste
0CE   ; 33           MOV     Q5,T             Richtungsschlange einen Platz weiter: ...
33E   ; 34           ANDI    #3,T             ... Platz 5 geht nach Platz 6 (Q0 Bit 3-4)
4EE   ; 35           ADD     T,T
4EE   ; 36           ADD     T,T
0BC   ; 37           MOV     Q4,Q5
0AB   ; 38           MOV     Q3,Q4
09A   ; 39           MOV     Q2,Q3
089   ; 3A           MOV     Q1,Q2
078   ; 3B           MOV     Q0,Q1            Vorwahl wird Platz 1 = dieser Zug
337   ; 3C           ANDI    #3,Q0            Platz 0 behält die Richtung (geradeaus)
4E7   ; 3D           ADD     T,Q0
07E   ; 3E           MOV     Q0,RICHT         Richtung dieses Zugs
33E   ; 3F           ANDI    #3,RICHT
00D   ; 40           MOV     KOPF_I,IDX
01F   ; 41           MOV     KOPF_M,MASKE
B93   ; 42           CALL    Schritt          außerhalb: Spielende
0D0   ; 43           MOV     IDX,KOPF_I
0F1   ; 44           MOV     MASKE,KOPF_M
84D   ; 45           CMP     FUTT_I,IDX       Futter?
E78   ; 46           BRZ     FutY

02D   ; 47  NoEat    MOV     SCHW_I,IDX       Schwanz löschen
03F   ; 48           MOV     SCHW_M,MASKE
BB0   ; 49           CALL    Zelle
06D   ; 4A           MOV     LAENGE,IDX       Richtung am Schwanz = Platz LAENGE
95D   ; 4B           CMPI    #5,IDX
D73   ; 4C           BRC     Lm               Platz 6-11: Q(Platz - 6), Bit 3-4

92D   ; 4D  Ld       CMPI    #2,IDX           Halbierung über Q0-Q5
D58   ; 4E           BRC     Lh
E56   ; 4F           BRZ     L2
90D   ; 50           CMPI    #0,IDX
E54   ; 51           BRZ     L0

08E   ; 52  L1       MOV     Q1,T
C60   ; 53           GOTO    Lj

07E   ; 54  L0       MOV     Q0,T
C60   ; 55           GOTO    Lj

09E   ; 56  L2       MOV     Q2,T
C60   ; 57           GOTO    Lj

94D   ; 58  Lh       CMPI    #4,IDX
D5F   ; 59           BRC     L5
E5D   ; 5A           BRZ     L4

0AE   ; 5B  L3       MOV     Q3,T
C60   ; 5C           GOTO    Lj

0BE   ; 5D  L4       MOV     Q4,T
C60   ; 5E           GOTO    Lj

0CE   ; 5F  L5       MOV     Q5,T

956   ; 60  Lj       CMPI    #5,LAENGE
D75   ; 61           BRC     LS               obere Hälfte: zwei Bits nach rechts

33E   ; 62  LA       ANDI    #3,T
02D   ; 63           MOV     SCHW_I,IDX       Schwanz einen Schritt weiter
03F   ; 64           MOV     SCHW_M,MASKE
B93   ; 65           CALL    Schritt
0D2   ; 66           MOV     IDX,SCHW_I
0F3   ; 67           MOV     MASKE,SCHW_M
B7F   ; 68           CALL    Taste
00D   ; 69           MOV     KOPF_I,IDX       Kopf setzen
01F   ; 6A           MOV     KOPF_M,MASKE
BB0   ; 6B           CALL    Zelle
E18   ; 6C           BRZ     Frame            Zelle war frei

06D   ; 6D  Ende     MOV     LAENGE,IDX       Spielende: Länge dezimal anzeigen (12 = gewonnen)
10E   ; 6E           MOVI    #0,T
10F   ; 6F           MOVI    #0,MASKE
F03   ; 70           HXDZ
F2D   ; 71           DISP    #2,IDX

C72   ; 72  Halt     GOTO    Halt             bleibt stehen

76D   ; 73  Lm       SUBI    #6,IDX
C4D   ; 74           GOTO    Ld

F9E   ; 75  LS       SHR     T
F9E   ; 76           SHR     T
C62   ; 77           GOTO    LA

85F   ; 78  FutY     CMP     FUTT_M,MASKE
E7B   ; 79           BRZ     Eat
C47   ; 7A           GOTO    NoEat

516   ; 7B  Eat      ADDI    #1,LAENGE        gefressen: Schwanz bleibt, Schlange wächst
9B6   ; 7C           CMPI    #B,LAENGE
D6D   ; 7D           BRC     Ende             Länge 12: gewonnen (Richtungsschlange voll)
C0B   ; 7E           GOTO    Futter

FDE   ; 7F  Taste    DIN     T                Taster: 1 links, 2 hoch, 3 runter, 4 rechts
E92   ; 80           BRZ     TRet
10F   ; 81           MOVI    #0,MASKE         Richtung = Nummer des niedrigsten Tasters - 1
F9E   ; 82           SHR     T                Taster 1: links (0)
D8B   ; 83           BRC     TC
51F   ; 84           ADDI    #1,MASKE
F9E   ; 85           SHR     T                Taster 2: hoch (1)
D8B   ; 86           BRC     TC
51F   ; 87           ADDI    #1,MASKE
F9E   ; 88           SHR     T                Taster 3: runter (2)
D8B   ; 89           BRC     TC
51F   ; 8A           ADDI    #1,MASKE         sonst Taster 4: rechts (3)

08E   ; 8B  TC       MOV     Q1,T             letzter Zug (Platz 1)
33E   ; 8C           ANDI    #3,T
4FE   ; 8D           ADD     MASKE,T          Summe 3 = Gegenrichtung: ignorieren
93E   ; 8E           CMPI    #3,T
E92   ; 8F           BRZ     TRet
3C7   ; 90           ANDI    #C,Q0            Vorwahl (Platz 0) setzen
4F7   ; 91           ADD     MASKE,Q0

F07   ; 92  TRet     RET

91E   ; 93  Schritt  CMPI    #1,RICHT         IDX/MASKE ein Feld in RICHT; außerhalb: Ende
D9C   ; 94           BRC     SHi
E99   ; 95           BRZ     SUp

F9F   ; 96  SLe      SHR     MASKE            0 = links
DA4   ; 97           BRC     SLX
F07   ; 98           RET

52D   ; 99  SUp      ADDI    #2,IDX           1 = hoch
D6D   ; 9A           BRC     Ende
F07   ; 9B           RET

92E   ; 9C  SHi      CMPI    #2,RICHT
EA1   ; 9D           BRZ     SDn

FAF   ; 9E  SRi      SHL     MASKE            3 = rechts
DAA   ; 9F           BRC     SRX
F07   ; A0           RET

72D   ; A1  SDn      SUBI    #2,IDX           2 = runter
D6D   ; A2           BRC     Ende
F07   ; A3           RET

71D   ; A4  SLX      SUBI    #1,IDX           links über die Registergrenze
0DE   ; A5           MOV     IDX,T
F9E   ; A6           SHR     T
D6D   ; A7           BRC     Ende             war linke Hälfte: Rand
18F   ; A8           MOVI    #8,MASKE
F07   ; A9           RET

0DE   ; AA  SRX      MOV     IDX,T            rechts über die Registergrenze
F9E   ; AB           SHR     T
D6D   ; AC           BRC     Ende             rechte Hälfte: Rand
11F   ; AD           MOVI    #1,MASKE
51D   ; AE           ADDI    #1,IDX
F07   ; AF           RET

97D   ; B0  Zelle    CMPI    #7,IDX           schaltet Zelle IDX/MASKE um (XOR); T = alter Wert
DB4   ; B1           BRC     ZoU
F0D   ; B2           EXRL                     Fenster Zeile 1-4: R0-R7 = M0-M7
CB7   ; B3           GOTO    ZSel

F0F   ; B4  ZoU      EXRA                     Fenster Zeile 5-8: R0-R7 = M8-MF
F0E   ; B5           EXRM
F0F   ; B6           EXRA

0DE   ; B7  ZSel     MOV     IDX,T
37E   ; B8           ANDI    #7,T
93E   ; B9           CMPI    #3,T             Halbierung über R0-R7
DD4   ; BA           BRC     Z47
91E   ; BB           CMPI    #1,T
DC8   ; BC           BRC     Z23
EC3   ; BD           BRZ     Z1

00E   ; BE  Z0       MOV     r0,T             T = Zelle
2FE   ; BF           AND     MASKE,T
AF0   ; C0           OR      MASKE,r0         XOR = (a oder m) - (a und m)
6E0   ; C1           SUB     T,r0
CEC   ; C2           GOTO    ZZu

01E   ; C3  Z1       MOV     r1,T             T = Zelle
2FE   ; C4           AND     MASKE,T
AF1   ; C5           OR      MASKE,r1         XOR = (a oder m) - (a und m)
6E1   ; C6           SUB     T,r1
CEC   ; C7           GOTO    ZZu

92E   ; C8  Z23      CMPI    #2,T
ECF   ; C9           BRZ     Z2

03E   ; CA  Z3       MOV     r3,T             T = Zelle
2FE   ; CB           AND     MASKE,T
AF3   ; CC           OR      MASKE,r3         XOR = (a oder m) - (a und m)
6E3   ; CD           SUB     T,r3
CEC   ; CE           GOTO    ZZu

02E   ; CF  Z2       MOV     r2,T             T = Zelle
2FE   ; D0           AND     MASKE,T
AF2   ; D1           OR      MASKE,r2         XOR = (a oder m) - (a und m)
6E2   ; D2           SUB     T,r2
CEC   ; D3           GOTO    ZZu

95E   ; D4  Z47      CMPI    #5,T
DE1   ; D5           BRC     Z67
EDC   ; D6           BRZ     Z5

04E   ; D7  Z4       MOV     r4,T             T = Zelle
2FE   ; D8           AND     MASKE,T
AF4   ; D9           OR      MASKE,r4         XOR = (a oder m) - (a und m)
6E4   ; DA           SUB     T,r4
CEC   ; DB           GOTO    ZZu

05E   ; DC  Z5       MOV     r5,T             T = Zelle
2FE   ; DD           AND     MASKE,T
AF5   ; DE           OR      MASKE,r5         XOR = (a oder m) - (a und m)
6E5   ; DF           SUB     T,r5
CEC   ; E0           GOTO    ZZu

96E   ; E1  Z67      CMPI    #6,T
EE8   ; E2           BRZ     Z6

07E   ; E3  Z7       MOV     r7,T             T = Zelle
2FE   ; E4           AND     MASKE,T
AF7   ; E5           OR      MASKE,r7         XOR = (a oder m) - (a und m)
6E7   ; E6           SUB     T,r7
CEC   ; E7           GOTO    ZZu

06E   ; E8  Z6       MOV     r6,T             T = Zelle
2FE   ; E9           AND     MASKE,T
AF6   ; EA           OR      MASKE,r6         XOR = (a oder m) - (a und m)
6E6   ; EB           SUB     T,r6

97D   ; EC  ZZu      CMPI    #7,IDX           Fenster zu
DF0   ; ED           BRC     ZzU
F0D   ; EE           EXRL
CF3   ; EF           GOTO    ZRet

F0F   ; F0  ZzU      EXRA
F0E   ; F1           EXRM
F0F   ; F2           EXRA

0EE   ; F3  ZRet     MOV     T,T              Zero-Flag = Zelle war frei
F07   ; F4           RET

FDF   ; F5  Schlaf   DIN     MASKE            Matrix schlafen legen: auf REQ (Eingang 1) warten ...
31F   ; F6           ANDI    #1,MASKE
EF5   ; F7           BRZ     Schlaf
1FF   ; F8  Tog      MOVI    #F,MASKE         ... ACK 15 (schlafen); Einsprung Tog: F weckt die Matrix
FEF   ; F9           DOT     MASKE
10F   ; FA           MOVI    #0,MASKE         Ausgaenge 0: nach dem Schlafen kann F wieder wecken,
FEF   ; FB           DOT     MASKE            nach dem Wecken gilt das naechste ACK
F07   ; FC           RET
