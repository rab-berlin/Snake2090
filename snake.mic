; snake-06.mic - Snake für Busch Microtronic 2090 mit 8x8-LED-Matrix (ESP2090 Studio) und 4 Tastern
; 246 Schritte (00-F5), frei: 10
; Version 03: Matrix des ESP2090 Studios. Zwischen den Bildern schlaeft sie (ACK 15, kein REQ), damit Eingang 1
;   Taster links sein kann; vor dem Bild weckt F, dann folgt ACK 1 mit den 16 Registern.
; Version 04: nach dem Wecken auf REQ warten statt ACK 1 blind zu senden (+2 Schritte).
; Version 05: Wecken als Handshake. Das F bleibt stehen, bis der ESP mit REQ antwortet, dann folgt direkt
;   ACK 1 (keine 0 dazwischen). So geht kein Wecken verloren, egal wie spaet der ESP nachsieht.
;   Schlafen steht jetzt direkt hinter dem Bild (kein Unterprogramm), am Start entfaellt es.
; Version 06: Der ESP schlaeft nach dem Bild von selbst wieder ein (ACK direkt aus dem gehaltenen F =
;   ein Befehl je Wecken). Das Schlafenlegen mit ACK 15 entfaellt, das Programm wartet nur noch beim
;   Wecken auf REQ.
; Start: Reset, Matrix einschalten (Weboberflaeche: LED on, Emulator2090: m), RUN.
;   Matrix vergessen? Das Programm wartet am Anfang ohne Bild: Matrix einschalten.
; Taster 1-4 = links, hoch, runter, rechts (Pfeiltasten). Umkehr wird ignoriert,
;   mehrere Taster: der niedrigste zählt. Taste halten, bis die Schlange reagiert.
; Die Matrix ist nur für das Bild wach, sonst schlaeft sie: Eingang 1 ist dann Taster links.
; Start mit Länge 2. Spielende (Rand oder sich selbst): Anzeige der Länge dezimal. Länge 12 = gewonnen.
; Ein Zug dauert etwa 1,4 s (155 Befehle), mit gehaltener Taste 1,8 s.
;
; #define (Register)
;   KOPF_I  r0  Kopf: Matrixregister 0-F (2 * Zeile + Hälfte)
;   KOPF_M  r1  Kopf: Bitmaske 1, 2, 4, 8 (Bit 1 = linke LED)
;   SCHW_I  r2  Schwanz: Matrixregister
;   SCHW_M  r3  Schwanz: Bitmaske
;   FUTT_I  r4  Futter: Matrixregister
;   FUTT_M  r5  Futter: Bitmaske
;   LAENGE  r6  Länge der Schlange 2-11 (= Platz der Schwanzrichtung)
;   Q0      r7  Richtungsschlange: Platz j in Q(j mod 6), Bit 1-2 für j<6, Bit 3-4 für j>=6
;   Q1      r8  Platz 0 = Vorwahl (Taste), Platz 1 = letzter Zug
;   Q2      r9
;   Q3      rA
;   Q4      rB
;   Q5      rC
;   IDX     rD  Hilfsregister: Matrixregister für Zelle/Schritt
;   T       rE  Hilfsregister: Ergebnis von Zelle, Richtung für Schritt
;   MASKE   rF  Hilfsregister: Bitmaske für Zelle/Schritt
;   RICHT   rE  Richtung für Schritt (= T): 0 links, 1 hoch, 2 runter, 3 rechts
;

F02   ; 00  Beginn   DISOUT                   Anzeige aus: 9,3 ms je Befehl (Takt der Matrix)
1C6   ; 01           MOVI    #C,LAENGE        Startbild: Zeile 4, Spalte 3-4 ...
F76   ; 02           MAS     LAENGE           ... nach M6 (Matrix liegt in M0-MF)
126   ; 03           MOVI    #2,LAENGE        Länge 2
160   ; 04           MOVI    #6,KOPF_I        Kopf Zeile 4, Spalte 4
181   ; 05           MOVI    #8,KOPF_M
162   ; 06           MOVI    #6,SCHW_I        Schwanz Zeile 4, Spalte 3
143   ; 07           MOVI    #4,SCHW_M
137   ; 08           MOVI    #3,Q0            Richtung 3 = rechts: Vorwahl ...
138   ; 09           MOVI    #3,Q1            ... und der letzte Zug

F05   ; 0A  Futter   RND                      neues Futter: IDX = Register, T = Spalte im Register
11F   ; 0B           MOVI    #1,MASKE
33E   ; 0C           ANDI    #3,T

71E   ; 0D  FL       SUBI    #1,T             Maske = 1 << T
D11   ; 0E           BRC     FD
4FF   ; 0F           ADD     MASKE,MASKE
C0D   ; 10           GOTO    FL

0D4   ; 11  FD       MOV     IDX,FUTT_I
0F5   ; 12           MOV     MASKE,FUTT_M
BB1   ; 13           CALL    Zelle            Futter setzen
E17   ; 14           BRZ     Frame            Zelle war frei
BB1   ; 15           CALL    Zelle            war Schlange: zurückschalten, neu würfeln
C0A   ; 16           GOTO    Futter

1FF   ; 17  Frame    MOVI    #F,MASKE         Matrix wecken: F anlegen und halten ...
FEF   ; 18           DOT     MASKE
F0D   ; 19           EXRL                     R0-R7 = Matrix Zeile 1-4, Variablen nach M0-M7

FDF   ; 1A  FW       DIN     MASKE            ... bis der ESP mit REQ antwortet (danach = 1 = ACK)
31F   ; 1B           ANDI    #1,MASKE
E1A   ; 1C           BRZ     FW
FEF   ; 1D           DOT     MASKE            ACK 1 direkt nach dem F
F0E   ; 1E           EXRM                     genau ein Befehl zwischen ACK und erstem Wert: R8-RF = Zeile 5-8
FE0   ; 1F           DOT     r0               Zeile 1 links
FE1   ; 20           DOT     r1               Zeile 1 rechts
FE2   ; 21           DOT     r2               Zeile 2 links
FE3   ; 22           DOT     r3               Zeile 2 rechts
FE4   ; 23           DOT     r4               Zeile 3 links
FE5   ; 24           DOT     r5               Zeile 3 rechts
FE6   ; 25           DOT     r6               Zeile 4 links
FE7   ; 26           DOT     r7               Zeile 4 rechts
FE8   ; 27           DOT     r8               Zeile 5 links
FE9   ; 28           DOT     r9               Zeile 5 rechts
FEA   ; 29           DOT     rA               Zeile 6 links
FEB   ; 2A           DOT     rB               Zeile 6 rechts
FEC   ; 2B           DOT     rC               Zeile 7 links
FED   ; 2C           DOT     rD               Zeile 7 rechts
FEE   ; 2D           DOT     rE               Zeile 8 links
FEF   ; 2E           DOT     rF               Zeile 8 rechts
F0E   ; 2F           EXRM                     Variablen zurück
10F   ; 30           MOVI    #0,MASKE
FEF   ; 31           DOT     MASKE            Ausgaenge 0: Uebertragung fertig
F0D   ; 32           EXRL

B80   ; 33  Tick     CALL    Taste
0CE   ; 34           MOV     Q5,T             Richtungsschlange einen Platz weiter: ...
33E   ; 35           ANDI    #3,T             ... Platz 5 geht nach Platz 6 (Q0 Bit 3-4)
4EE   ; 36           ADD     T,T
4EE   ; 37           ADD     T,T
0BC   ; 38           MOV     Q4,Q5
0AB   ; 39           MOV     Q3,Q4
09A   ; 3A           MOV     Q2,Q3
089   ; 3B           MOV     Q1,Q2
078   ; 3C           MOV     Q0,Q1            Vorwahl wird Platz 1 = dieser Zug
337   ; 3D           ANDI    #3,Q0            Platz 0 behält die Richtung (geradeaus)
4E7   ; 3E           ADD     T,Q0
07E   ; 3F           MOV     Q0,RICHT         Richtung dieses Zugs
33E   ; 40           ANDI    #3,RICHT
00D   ; 41           MOV     KOPF_I,IDX
01F   ; 42           MOV     KOPF_M,MASKE
B94   ; 43           CALL    Schritt          außerhalb: Spielende
0D0   ; 44           MOV     IDX,KOPF_I
0F1   ; 45           MOV     MASKE,KOPF_M
84D   ; 46           CMP     FUTT_I,IDX       Futter?
E79   ; 47           BRZ     FutY

02D   ; 48  NoEat    MOV     SCHW_I,IDX       Schwanz löschen
03F   ; 49           MOV     SCHW_M,MASKE
BB1   ; 4A           CALL    Zelle
06D   ; 4B           MOV     LAENGE,IDX       Richtung am Schwanz = Platz LAENGE
95D   ; 4C           CMPI    #5,IDX
D74   ; 4D           BRC     Lm               Platz 6-11: Q(Platz - 6), Bit 3-4

92D   ; 4E  Ld       CMPI    #2,IDX           Halbierung über Q0-Q5
D59   ; 4F           BRC     Lh
E57   ; 50           BRZ     L2
90D   ; 51           CMPI    #0,IDX
E55   ; 52           BRZ     L0

08E   ; 53  L1       MOV     Q1,T
C61   ; 54           GOTO    Lj

07E   ; 55  L0       MOV     Q0,T
C61   ; 56           GOTO    Lj

09E   ; 57  L2       MOV     Q2,T
C61   ; 58           GOTO    Lj

94D   ; 59  Lh       CMPI    #4,IDX
D60   ; 5A           BRC     L5
E5E   ; 5B           BRZ     L4

0AE   ; 5C  L3       MOV     Q3,T
C61   ; 5D           GOTO    Lj

0BE   ; 5E  L4       MOV     Q4,T
C61   ; 5F           GOTO    Lj

0CE   ; 60  L5       MOV     Q5,T

956   ; 61  Lj       CMPI    #5,LAENGE
D76   ; 62           BRC     LS               obere Hälfte: zwei Bits nach rechts

33E   ; 63  LA       ANDI    #3,T
02D   ; 64           MOV     SCHW_I,IDX       Schwanz einen Schritt weiter
03F   ; 65           MOV     SCHW_M,MASKE
B94   ; 66           CALL    Schritt
0D2   ; 67           MOV     IDX,SCHW_I
0F3   ; 68           MOV     MASKE,SCHW_M
B80   ; 69           CALL    Taste
00D   ; 6A           MOV     KOPF_I,IDX       Kopf setzen
01F   ; 6B           MOV     KOPF_M,MASKE
BB1   ; 6C           CALL    Zelle
E17   ; 6D           BRZ     Frame            Zelle war frei

06D   ; 6E  Ende     MOV     LAENGE,IDX       Spielende: Länge dezimal anzeigen (12 = gewonnen)
10E   ; 6F           MOVI    #0,T
10F   ; 70           MOVI    #0,MASKE
F03   ; 71           HXDZ
F2D   ; 72           DISP    #2,IDX

C73   ; 73  Halt     GOTO    Halt             bleibt stehen

76D   ; 74  Lm       SUBI    #6,IDX
C4E   ; 75           GOTO    Ld

F9E   ; 76  LS       SHR     T
F9E   ; 77           SHR     T
C63   ; 78           GOTO    LA

85F   ; 79  FutY     CMP     FUTT_M,MASKE
E7C   ; 7A           BRZ     Eat
C48   ; 7B           GOTO    NoEat

516   ; 7C  Eat      ADDI    #1,LAENGE        gefressen: Schwanz bleibt, Schlange wächst
9B6   ; 7D           CMPI    #B,LAENGE
D6E   ; 7E           BRC     Ende             Länge 12: gewonnen (Richtungsschlange voll)
C0A   ; 7F           GOTO    Futter

FDE   ; 80  Taste    DIN     T                Taster: 1 links, 2 hoch, 3 runter, 4 rechts
E93   ; 81           BRZ     TRet
10F   ; 82           MOVI    #0,MASKE         Richtung = Nummer des niedrigsten Tasters - 1
F9E   ; 83           SHR     T                Taster 1: links (0)
D8C   ; 84           BRC     TC
51F   ; 85           ADDI    #1,MASKE
F9E   ; 86           SHR     T                Taster 2: hoch (1)
D8C   ; 87           BRC     TC
51F   ; 88           ADDI    #1,MASKE
F9E   ; 89           SHR     T                Taster 3: runter (2)
D8C   ; 8A           BRC     TC
51F   ; 8B           ADDI    #1,MASKE         sonst Taster 4: rechts (3)

08E   ; 8C  TC       MOV     Q1,T             letzter Zug (Platz 1)
33E   ; 8D           ANDI    #3,T
4FE   ; 8E           ADD     MASKE,T          Summe 3 = Gegenrichtung: ignorieren
93E   ; 8F           CMPI    #3,T
E93   ; 90           BRZ     TRet
3C7   ; 91           ANDI    #C,Q0            Vorwahl (Platz 0) setzen
4F7   ; 92           ADD     MASKE,Q0

F07   ; 93  TRet     RET

91E   ; 94  Schritt  CMPI    #1,RICHT         IDX/MASKE ein Feld in RICHT; außerhalb: Ende
D9D   ; 95           BRC     SHi
E9A   ; 96           BRZ     SUp

F9F   ; 97  SLe      SHR     MASKE            0 = links
DA5   ; 98           BRC     SLX
F07   ; 99           RET

52D   ; 9A  SUp      ADDI    #2,IDX           1 = hoch
D6E   ; 9B           BRC     Ende
F07   ; 9C           RET

92E   ; 9D  SHi      CMPI    #2,RICHT
EA2   ; 9E           BRZ     SDn

FAF   ; 9F  SRi      SHL     MASKE            3 = rechts
DAB   ; A0           BRC     SRX
F07   ; A1           RET

72D   ; A2  SDn      SUBI    #2,IDX           2 = runter
D6E   ; A3           BRC     Ende
F07   ; A4           RET

71D   ; A5  SLX      SUBI    #1,IDX           links über die Registergrenze
0DE   ; A6           MOV     IDX,T
F9E   ; A7           SHR     T
D6E   ; A8           BRC     Ende             war linke Hälfte: Rand
18F   ; A9           MOVI    #8,MASKE
F07   ; AA           RET

0DE   ; AB  SRX      MOV     IDX,T            rechts über die Registergrenze
F9E   ; AC           SHR     T
D6E   ; AD           BRC     Ende             rechte Hälfte: Rand
11F   ; AE           MOVI    #1,MASKE
51D   ; AF           ADDI    #1,IDX
F07   ; B0           RET

97D   ; B1  Zelle    CMPI    #7,IDX           schaltet Zelle IDX/MASKE um (XOR); T = alter Wert
DB5   ; B2           BRC     ZoU
F0D   ; B3           EXRL                     Fenster Zeile 1-4: R0-R7 = M0-M7
CB8   ; B4           GOTO    ZSel

F0F   ; B5  ZoU      EXRA                     Fenster Zeile 5-8: R0-R7 = M8-MF
F0E   ; B6           EXRM
F0F   ; B7           EXRA

0DE   ; B8  ZSel     MOV     IDX,T
37E   ; B9           ANDI    #7,T
93E   ; BA           CMPI    #3,T             Halbierung über R0-R7
DD5   ; BB           BRC     Z47
91E   ; BC           CMPI    #1,T
DC9   ; BD           BRC     Z23
EC4   ; BE           BRZ     Z1

00E   ; BF  Z0       MOV     r0,T             T = Zelle
2FE   ; C0           AND     MASKE,T
AF0   ; C1           OR      MASKE,r0         XOR = (a oder m) - (a und m)
6E0   ; C2           SUB     T,r0
CED   ; C3           GOTO    ZZu

01E   ; C4  Z1       MOV     r1,T             T = Zelle
2FE   ; C5           AND     MASKE,T
AF1   ; C6           OR      MASKE,r1         XOR = (a oder m) - (a und m)
6E1   ; C7           SUB     T,r1
CED   ; C8           GOTO    ZZu

92E   ; C9  Z23      CMPI    #2,T
ED0   ; CA           BRZ     Z2

03E   ; CB  Z3       MOV     r3,T             T = Zelle
2FE   ; CC           AND     MASKE,T
AF3   ; CD           OR      MASKE,r3         XOR = (a oder m) - (a und m)
6E3   ; CE           SUB     T,r3
CED   ; CF           GOTO    ZZu

02E   ; D0  Z2       MOV     r2,T             T = Zelle
2FE   ; D1           AND     MASKE,T
AF2   ; D2           OR      MASKE,r2         XOR = (a oder m) - (a und m)
6E2   ; D3           SUB     T,r2
CED   ; D4           GOTO    ZZu

95E   ; D5  Z47      CMPI    #5,T
DE2   ; D6           BRC     Z67
EDD   ; D7           BRZ     Z5

04E   ; D8  Z4       MOV     r4,T             T = Zelle
2FE   ; D9           AND     MASKE,T
AF4   ; DA           OR      MASKE,r4         XOR = (a oder m) - (a und m)
6E4   ; DB           SUB     T,r4
CED   ; DC           GOTO    ZZu

05E   ; DD  Z5       MOV     r5,T             T = Zelle
2FE   ; DE           AND     MASKE,T
AF5   ; DF           OR      MASKE,r5         XOR = (a oder m) - (a und m)
6E5   ; E0           SUB     T,r5
CED   ; E1           GOTO    ZZu

96E   ; E2  Z67      CMPI    #6,T
EE9   ; E3           BRZ     Z6

07E   ; E4  Z7       MOV     r7,T             T = Zelle
2FE   ; E5           AND     MASKE,T
AF7   ; E6           OR      MASKE,r7         XOR = (a oder m) - (a und m)
6E7   ; E7           SUB     T,r7
CED   ; E8           GOTO    ZZu

06E   ; E9  Z6       MOV     r6,T             T = Zelle
2FE   ; EA           AND     MASKE,T
AF6   ; EB           OR      MASKE,r6         XOR = (a oder m) - (a und m)
6E6   ; EC           SUB     T,r6

97D   ; ED  ZZu      CMPI    #7,IDX           Fenster zu
DF1   ; EE           BRC     ZzU
F0D   ; EF           EXRL
CF4   ; F0           GOTO    ZRet

F0F   ; F1  ZzU      EXRA
F0E   ; F2           EXRM
F0F   ; F3           EXRA

0EE   ; F4  ZRet     MOV     T,T              Zero-Flag = Zelle war frei
F07   ; F5           RET
