; snake-05.mic - Snake für Busch Microtronic 2090 mit 8x8-LED-Matrix (ESP2090 Studio) und 4 Tastern
; 253 Schritte (00-FC), frei: 3
; Version 03: Matrix des ESP2090 Studios. Zwischen den Bildern schlaeft sie (ACK 15, kein REQ), damit Eingang 1
;   Taster links sein kann; vor dem Bild weckt F, dann folgt ACK 1 mit den 16 Registern.
; Version 04: nach dem Wecken auf REQ warten statt ACK 1 blind zu senden (+2 Schritte).
; Version 05: Wecken als Handshake. Das F bleibt stehen, bis der ESP mit REQ antwortet, dann folgt direkt
;   ACK 1 (keine 0 dazwischen). So geht kein Wecken verloren, egal wie spaet der ESP nachsieht.
;   Schlafen steht jetzt direkt hinter dem Bild (kein Unterprogramm), am Start entfaellt es.
; Start: Reset, Matrix einschalten (Weboberflaeche: LED on, Emulator2090: m), RUN.
;   Matrix vergessen? Das Programm wartet am Anfang ohne Bild: Matrix einschalten.
; Taster 1-4 = links, hoch, runter, rechts (Pfeiltasten). Umkehr wird ignoriert,
;   mehrere Taster: der niedrigste zählt. Taste halten, bis die Schlange reagiert.
; Die Matrix ist nur für das Bild wach, sonst schlaeft sie: Eingang 1 ist dann Taster links.
; Start mit Länge 2. Spielende (Rand oder sich selbst): Anzeige der Länge dezimal. Länge 12 = gewonnen.
; Ein Zug dauert etwa 1,4 s (155 Befehle), mit gehaltener Taste 1,8 s.
;
; #define (Register)
;   KOPF_I  r0  Kopf: Matrixregister 0-F (2 * Zeile + Hälfte)
;   KOPF_M  r1  Kopf: Bitmaske 1, 2, 4, 8 (Bit 1 = linke LED)
;   SCHW_I  r2  Schwanz: Matrixregister
;   SCHW_M  r3  Schwanz: Bitmaske
;   FUTT_I  r4  Futter: Matrixregister
;   FUTT_M  r5  Futter: Bitmaske
;   LAENGE  r6  Länge der Schlange 2-11 (= Platz der Schwanzrichtung)
;   Q0      r7  Richtungsschlange: Platz j in Q(j mod 6), Bit 1-2 für j<6, Bit 3-4 für j>=6
;   Q1      r8  Platz 0 = Vorwahl (Taste), Platz 1 = letzter Zug
;   Q2      r9
;   Q3      rA
;   Q4      rB
;   Q5      rC
;   IDX     rD  Hilfsregister: Matrixregister für Zelle/Schritt
;   T       rE  Hilfsregister: Ergebnis von Zelle, Richtung für Schritt
;   MASKE   rF  Hilfsregister: Bitmaske für Zelle/Schritt
;   RICHT   rE  Richtung für Schritt (= T): 0 links, 1 hoch, 2 runter, 3 rechts
;

F02   ; 00  Beginn   DISOUT                   Anzeige aus: 9,3 ms je Befehl (Takt der Matrix)
1C6   ; 01           MOVI    #C,LAENGE        Startbild: Zeile 4, Spalte 3-4 ...
F76   ; 02           MAS     LAENGE           ... nach M6 (Matrix liegt in M0-MF)
126   ; 03           MOVI    #2,LAENGE        Länge 2
160   ; 04           MOVI    #6,KOPF_I        Kopf Zeile 4, Spalte 4
181   ; 05           MOVI    #8,KOPF_M
162   ; 06           MOVI    #6,SCHW_I        Schwanz Zeile 4, Spalte 3
143   ; 07           MOVI    #4,SCHW_M
137   ; 08           MOVI    #3,Q0            Richtung 3 = rechts: Vorwahl ...
138   ; 09           MOVI    #3,Q1            ... und der letzte Zug

F05   ; 0A  Futter   RND                      neues Futter: IDX = Register, T = Spalte im Register
11F   ; 0B           MOVI    #1,MASKE
33E   ; 0C           ANDI    #3,T

71E   ; 0D  FL       SUBI    #1,T             Maske = 1 << T
D11   ; 0E           BRC     FD
4FF   ; 0F           ADD     MASKE,MASKE
C0D   ; 10           GOTO    FL

0D4   ; 11  FD       MOV     IDX,FUTT_I
0F5   ; 12           MOV     MASKE,FUTT_M
BB8   ; 13           CALL    Zelle            Futter setzen
E17   ; 14           BRZ     Frame            Zelle war frei
BB8   ; 15           CALL    Zelle            war Schlange: zurückschalten, neu würfeln
C0A   ; 16           GOTO    Futter

1FF   ; 17  Frame    MOVI    #F,MASKE         Matrix wecken: F anlegen und halten ...
FEF   ; 18           DOT     MASKE
F0D   ; 19           EXRL                     R0-R7 = Matrix Zeile 1-4, Variablen nach M0-M7

FDF   ; 1A  FW       DIN     MASKE            ... bis der ESP mit REQ antwortet (danach = 1 = ACK)
31F   ; 1B           ANDI    #1,MASKE
E1A   ; 1C           BRZ     FW
FEF   ; 1D           DOT     MASKE            ACK 1 direkt nach dem F
F0E   ; 1E           EXRM                     genau ein Befehl zwischen ACK und erstem Wert: R8-RF = Zeile 5-8
FE0   ; 1F           DOT     r0               Zeile 1 links
FE1   ; 20           DOT     r1               Zeile 1 rechts
FE2   ; 21           DOT     r2               Zeile 2 links
FE3   ; 22           DOT     r3               Zeile 2 rechts
FE4   ; 23           DOT     r4               Zeile 3 links
FE5   ; 24           DOT     r5               Zeile 3 rechts
FE6   ; 25           DOT     r6               Zeile 4 links
FE7   ; 26           DOT     r7               Zeile 4 rechts
FE8   ; 27           DOT     r8               Zeile 5 links
FE9   ; 28           DOT     r9               Zeile 5 rechts
FEA   ; 29           DOT     rA               Zeile 6 links
FEB   ; 2A           DOT     rB               Zeile 6 rechts
FEC   ; 2B           DOT     rC               Zeile 7 links
FED   ; 2C           DOT     rD               Zeile 7 rechts
FEE   ; 2D           DOT     rE               Zeile 8 links
FEF   ; 2E           DOT     rF               Zeile 8 rechts
F0E   ; 2F           EXRM                     Variablen zurück
10F   ; 30           MOVI    #0,MASKE
FEF   ; 31           DOT     MASKE            Ausgaenge 0: Uebertragung fertig
F0D   ; 32           EXRL
FDF   ; 33  Schlaf   DIN     MASKE            Matrix schlafen legen: auf REQ warten ...
31F   ; 34           ANDI    #1,MASKE
E33   ; 35           BRZ     Schlaf
1FF   ; 36           MOVI    #F,MASKE         ... ACK 15 (schlafen)
FEF   ; 37           DOT     MASKE
10F   ; 38           MOVI    #0,MASKE         nach 2 Schritten wegnehmen (laenger als 40 ms waere Wecken)
FEF   ; 39           DOT     MASKE            Eingang 1 ist jetzt Taster links

B87   ; 3A  Tick     CALL    Taste
0CE   ; 3B           MOV     Q5,T             Richtungsschlange einen Platz weiter: ...
33E   ; 3C           ANDI    #3,T             ... Platz 5 geht nach Platz 6 (Q0 Bit 3-4)
4EE   ; 3D           ADD     T,T
4EE   ; 3E           ADD     T,T
0BC   ; 3F           MOV     Q4,Q5
0AB   ; 40           MOV     Q3,Q4
09A   ; 41           MOV     Q2,Q3
089   ; 42           MOV     Q1,Q2
078   ; 43           MOV     Q0,Q1            Vorwahl wird Platz 1 = dieser Zug
337   ; 44           ANDI    #3,Q0            Platz 0 behält die Richtung (geradeaus)
4E7   ; 45           ADD     T,Q0
07E   ; 46           MOV     Q0,RICHT         Richtung dieses Zugs
33E   ; 47           ANDI    #3,RICHT
00D   ; 48           MOV     KOPF_I,IDX
01F   ; 49           MOV     KOPF_M,MASKE
B9B   ; 4A           CALL    Schritt          außerhalb: Spielende
0D0   ; 4B           MOV     IDX,KOPF_I
0F1   ; 4C           MOV     MASKE,KOPF_M
84D   ; 4D           CMP     FUTT_I,IDX       Futter?
E80   ; 4E           BRZ     FutY

02D   ; 4F  NoEat    MOV     SCHW_I,IDX       Schwanz löschen
03F   ; 50           MOV     SCHW_M,MASKE
BB8   ; 51           CALL    Zelle
06D   ; 52           MOV     LAENGE,IDX       Richtung am Schwanz = Platz LAENGE
95D   ; 53           CMPI    #5,IDX
D7B   ; 54           BRC     Lm               Platz 6-11: Q(Platz - 6), Bit 3-4

92D   ; 55  Ld       CMPI    #2,IDX           Halbierung über Q0-Q5
D60   ; 56           BRC     Lh
E5E   ; 57           BRZ     L2
90D   ; 58           CMPI    #0,IDX
E5C   ; 59           BRZ     L0

08E   ; 5A  L1       MOV     Q1,T
C68   ; 5B           GOTO    Lj

07E   ; 5C  L0       MOV     Q0,T
C68   ; 5D           GOTO    Lj

09E   ; 5E  L2       MOV     Q2,T
C68   ; 5F           GOTO    Lj

94D   ; 60  Lh       CMPI    #4,IDX
D67   ; 61           BRC     L5
E65   ; 62           BRZ     L4

0AE   ; 63  L3       MOV     Q3,T
C68   ; 64           GOTO    Lj

0BE   ; 65  L4       MOV     Q4,T
C68   ; 66           GOTO    Lj

0CE   ; 67  L5       MOV     Q5,T

956   ; 68  Lj       CMPI    #5,LAENGE
D7D   ; 69           BRC     LS               obere Hälfte: zwei Bits nach rechts

33E   ; 6A  LA       ANDI    #3,T
02D   ; 6B           MOV     SCHW_I,IDX       Schwanz einen Schritt weiter
03F   ; 6C           MOV     SCHW_M,MASKE
B9B   ; 6D           CALL    Schritt
0D2   ; 6E           MOV     IDX,SCHW_I
0F3   ; 6F           MOV     MASKE,SCHW_M
B87   ; 70           CALL    Taste
00D   ; 71           MOV     KOPF_I,IDX       Kopf setzen
01F   ; 72           MOV     KOPF_M,MASKE
BB8   ; 73           CALL    Zelle
E17   ; 74           BRZ     Frame            Zelle war frei

06D   ; 75  Ende     MOV     LAENGE,IDX       Spielende: Länge dezimal anzeigen (12 = gewonnen)
10E   ; 76           MOVI    #0,T
10F   ; 77           MOVI    #0,MASKE
F03   ; 78           HXDZ
F2D   ; 79           DISP    #2,IDX

C7A   ; 7A  Halt     GOTO    Halt             bleibt stehen

76D   ; 7B  Lm       SUBI    #6,IDX
C55   ; 7C           GOTO    Ld

F9E   ; 7D  LS       SHR     T
F9E   ; 7E           SHR     T
C6A   ; 7F           GOTO    LA

85F   ; 80  FutY     CMP     FUTT_M,MASKE
E83   ; 81           BRZ     Eat
C4F   ; 82           GOTO    NoEat

516   ; 83  Eat      ADDI    #1,LAENGE        gefressen: Schwanz bleibt, Schlange wächst
9B6   ; 84           CMPI    #B,LAENGE
D75   ; 85           BRC     Ende             Länge 12: gewonnen (Richtungsschlange voll)
C0A   ; 86           GOTO    Futter

FDE   ; 87  Taste    DIN     T                Taster: 1 links, 2 hoch, 3 runter, 4 rechts
E9A   ; 88           BRZ     TRet
10F   ; 89           MOVI    #0,MASKE         Richtung = Nummer des niedrigsten Tasters - 1
F9E   ; 8A           SHR     T                Taster 1: links (0)
D93   ; 8B           BRC     TC
51F   ; 8C           ADDI    #1,MASKE
F9E   ; 8D           SHR     T                Taster 2: hoch (1)
D93   ; 8E           BRC     TC
51F   ; 8F           ADDI    #1,MASKE
F9E   ; 90           SHR     T                Taster 3: runter (2)
D93   ; 91           BRC     TC
51F   ; 92           ADDI    #1,MASKE         sonst Taster 4: rechts (3)

08E   ; 93  TC       MOV     Q1,T             letzter Zug (Platz 1)
33E   ; 94           ANDI    #3,T
4FE   ; 95           ADD     MASKE,T          Summe 3 = Gegenrichtung: ignorieren
93E   ; 96           CMPI    #3,T
E9A   ; 97           BRZ     TRet
3C7   ; 98           ANDI    #C,Q0            Vorwahl (Platz 0) setzen
4F7   ; 99           ADD     MASKE,Q0

F07   ; 9A  TRet     RET

91E   ; 9B  Schritt  CMPI    #1,RICHT         IDX/MASKE ein Feld in RICHT; außerhalb: Ende
DA4   ; 9C           BRC     SHi
EA1   ; 9D           BRZ     SUp

F9F   ; 9E  SLe      SHR     MASKE            0 = links
DAC   ; 9F           BRC     SLX
F07   ; A0           RET

52D   ; A1  SUp      ADDI    #2,IDX           1 = hoch
D75   ; A2           BRC     Ende
F07   ; A3           RET

92E   ; A4  SHi      CMPI    #2,RICHT
EA9   ; A5           BRZ     SDn

FAF   ; A6  SRi      SHL     MASKE            3 = rechts
DB2   ; A7           BRC     SRX
F07   ; A8           RET

72D   ; A9  SDn      SUBI    #2,IDX           2 = runter
D75   ; AA           BRC     Ende
F07   ; AB           RET

71D   ; AC  SLX      SUBI    #1,IDX           links über die Registergrenze
0DE   ; AD           MOV     IDX,T
F9E   ; AE           SHR     T
D75   ; AF           BRC     Ende             war linke Hälfte: Rand
18F   ; B0           MOVI    #8,MASKE
F07   ; B1           RET

0DE   ; B2  SRX      MOV     IDX,T            rechts über die Registergrenze
F9E   ; B3           SHR     T
D75   ; B4           BRC     Ende             rechte Hälfte: Rand
11F   ; B5           MOVI    #1,MASKE
51D   ; B6           ADDI    #1,IDX
F07   ; B7           RET

97D   ; B8  Zelle    CMPI    #7,IDX           schaltet Zelle IDX/MASKE um (XOR); T = alter Wert
DBC   ; B9           BRC     ZoU
F0D   ; BA           EXRL                     Fenster Zeile 1-4: R0-R7 = M0-M7
CBF   ; BB           GOTO    ZSel

F0F   ; BC  ZoU      EXRA                     Fenster Zeile 5-8: R0-R7 = M8-MF
F0E   ; BD           EXRM
F0F   ; BE           EXRA

0DE   ; BF  ZSel     MOV     IDX,T
37E   ; C0           ANDI    #7,T
93E   ; C1           CMPI    #3,T             Halbierung über R0-R7
DDC   ; C2           BRC     Z47
91E   ; C3           CMPI    #1,T
DD0   ; C4           BRC     Z23
ECB   ; C5           BRZ     Z1

00E   ; C6  Z0       MOV     r0,T             T = Zelle
2FE   ; C7           AND     MASKE,T
AF0   ; C8           OR      MASKE,r0         XOR = (a oder m) - (a und m)
6E0   ; C9           SUB     T,r0
CF4   ; CA           GOTO    ZZu

01E   ; CB  Z1       MOV     r1,T             T = Zelle
2FE   ; CC           AND     MASKE,T
AF1   ; CD           OR      MASKE,r1         XOR = (a oder m) - (a und m)
6E1   ; CE           SUB     T,r1
CF4   ; CF           GOTO    ZZu

92E   ; D0  Z23      CMPI    #2,T
ED7   ; D1           BRZ     Z2

03E   ; D2  Z3       MOV     r3,T             T = Zelle
2FE   ; D3           AND     MASKE,T
AF3   ; D4           OR      MASKE,r3         XOR = (a oder m) - (a und m)
6E3   ; D5           SUB     T,r3
CF4   ; D6           GOTO    ZZu

02E   ; D7  Z2       MOV     r2,T             T = Zelle
2FE   ; D8           AND     MASKE,T
AF2   ; D9           OR      MASKE,r2         XOR = (a oder m) - (a und m)
6E2   ; DA           SUB     T,r2
CF4   ; DB           GOTO    ZZu

95E   ; DC  Z47      CMPI    #5,T
DE9   ; DD           BRC     Z67
EE4   ; DE           BRZ     Z5

04E   ; DF  Z4       MOV     r4,T             T = Zelle
2FE   ; E0           AND     MASKE,T
AF4   ; E1           OR      MASKE,r4         XOR = (a oder m) - (a und m)
6E4   ; E2           SUB     T,r4
CF4   ; E3           GOTO    ZZu

05E   ; E4  Z5       MOV     r5,T             T = Zelle
2FE   ; E5           AND     MASKE,T
AF5   ; E6           OR      MASKE,r5         XOR = (a oder m) - (a und m)
6E5   ; E7           SUB     T,r5
CF4   ; E8           GOTO    ZZu

96E   ; E9  Z67      CMPI    #6,T
EF0   ; EA           BRZ     Z6

07E   ; EB  Z7       MOV     r7,T             T = Zelle
2FE   ; EC           AND     MASKE,T
AF7   ; ED           OR      MASKE,r7         XOR = (a oder m) - (a und m)
6E7   ; EE           SUB     T,r7
CF4   ; EF           GOTO    ZZu

06E   ; F0  Z6       MOV     r6,T             T = Zelle
2FE   ; F1           AND     MASKE,T
AF6   ; F2           OR      MASKE,r6         XOR = (a oder m) - (a und m)
6E6   ; F3           SUB     T,r6

97D   ; F4  ZZu      CMPI    #7,IDX           Fenster zu
DF8   ; F5           BRC     ZzU
F0D   ; F6           EXRL
CFB   ; F7           GOTO    ZRet

F0F   ; F8  ZzU      EXRA
F0E   ; F9           EXRM
F0F   ; FA           EXRA

0EE   ; FB  ZRet     MOV     T,T              Zero-Flag = Zelle war frei
F07   ; FC           RET
